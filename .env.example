# TAEMRY FLUX - Environment Configuration
# Add your Firebase Web App credentials below

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=taemry-flux.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=taemry-flux
VITE_FIREBASE_STORAGE_BUCKET=taemry-flux.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

