# TAEMRY FLUX - Environment Configuration Example

# Gemini API Key (Server-side AI capability)
GEMINI_API_KEY=

# Firebase Admin SDK Credentials (Optional for local development; fallback mock Firestore active)
FIREBASE_PROJECT_ID=taemry-flux
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=taemry-flux.firebasestorage.app

# SMTP Mail & Admin Alerts Service (Optional; mock email logger active by default)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TAEMRY FLUX Alerts" <no-reply@taemryflux.com>
ADMIN_ALERT_EMAIL=mistrtaemry@gmail.com

# Client-Side Public API Base URL (Default fallback is '/api' for single-port full-stack container)
VITE_API_BASE_URL=/api
